---
import { ClientRouter } from 'astro:transitions';
import { content, type Locale } from '../data/resume';
import '@fontsource-variable/manrope';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/600.css';
import '../styles/global.css';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale];
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#f8f8f5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_CA'} />
    <link rel="alternate" hreflang="zh-CN" href="/zh/" />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t.title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <slot />
  </body>
</html>
<script>
  import { mountMotion } from '../lib/motion';
  import { mountHeroGallery } from '../lib/hero-gallery';
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const controller = new AbortController();
    const { signal } = controller;
    const stopMotion = mountMotion();
    const stopGallery = mountHeroGallery();
    const anchor = location.hash
      ? document.getElementById(location.hash.slice(1))
      : null;
    if (anchor) {
      const precedingIslands = [
        ...document.querySelectorAll<HTMLElement>(
          'astro-island[client="load"]',
        ),
      ].filter(
        (island) =>
          island.compareDocumentPosition(anchor) &
          Node.DOCUMENT_POSITION_FOLLOWING,
      );
      // Hydration can change the height above a hash target after Astro scrolls.
      void Promise.all(
        precedingIslands.map(
          (island) =>
            new Promise<void>((resolve) => {
              if (!island.hasAttribute('ssr')) return resolve();
              island.addEventListener('astro:hydrate', () => resolve(), {
                once: true,
              });
            }),
        ),
      ).then(async () => {
        await document.fonts.ready;
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            if (!signal.aborted && location.hash === `#${anchor.id}`)
              anchor.scrollIntoView({ behavior: 'instant', block: 'start' });
          }),
        );
      });
    }
    document
      .querySelectorAll<HTMLButtonElement>('.copy-email')
      .forEach((copy) =>
        copy.addEventListener(
          'click',
          async () => {
            const status = copy
              .closest('.contact-item')
              ?.querySelector('.copy-status');
            try {
              await navigator.clipboard.writeText(copy.dataset.email!);
              if (status) status.textContent = copy.dataset.success!;
            } catch {
              if (status) status.textContent = copy.dataset.error!;
            }
          },
          { signal },
        ),
      );
    // Retain the current section when switching language, using real crawlable URLs.
    document
      .querySelectorAll<HTMLAnchorElement>('.language-switch a')
      .forEach((link) => {
        link.addEventListener(
          'click',
          () => {
            link.hash = location.hash;
          },
          { signal },
        );
      });
    cleanup = () => {
      controller.abort();
      stopMotion();
      stopGallery();
    };
  });
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
