---
import { content, projects, type Locale } from '../data/resume';
import BrandIcon from './BrandIcon.astro';
const { locale } = Astro.props as { locale: Locale };
---

<!-- Only real projects are rendered. Desktop motion adds inert copies to fill each row. -->
<div class="project-drift" aria-label={content[locale].projects.overview}>
  <div class="drift-tilt">
    <div class="drift-row" data-drift-row>
      {projects.map((project) => (
        <a
          class="drift-tile"
          style={project.tone ? `--tile-color:${project.tone}` : undefined}
          href={`#${project.id}`}
          data-astro-reload
        >
          <span class="drift-tile-category">{project.category[locale]}</span>
          <span class="drift-tile-mark" aria-hidden="true">
            <BrandIcon name={project.tags[0] ?? ''} size={56} />
          </span>
          <span class="drift-tile-caption">
            <span class="drift-tile-name">{project.name}</span>
            <span aria-hidden="true">↗</span>
          </span>
          <span class="drift-tile-stack">{project.tags.join(' / ')}</span>
        </a>
      ))}
    </div>
  </div>
</div>
