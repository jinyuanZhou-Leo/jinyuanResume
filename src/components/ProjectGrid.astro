---
import { content, projects, type Locale } from '../data/resume';
import BrandIcon from './BrandIcon.astro';
const { locale } = Astro.props as { locale: Locale };
---

<!-- Only real projects are rendered. Desktop motion creates inert copies at runtime. -->
<div class="project-overview" aria-label={content[locale].projects.overview}>
  <div class="project-grid-stage">
    <div class="project-grid-tilt">
      <div class="project-grid-row" data-grid-row>
        {projects.map((project) => (
          <a
            class="project-grid-tile"
            style={project.tone ? `--tile-color:${project.tone}` : undefined}
            href={`#${project.id}`}
            data-astro-reload
          >
            <span class="grid-tile-category">{project.category[locale]}</span>
            <div class="grid-tile-mark" aria-hidden="true">
              <BrandIcon name={project.tags[0] ?? ''} size={56} />
            </div>
            <div class="grid-tile-caption">
              <h3>{project.name}</h3>
              <span aria-hidden="true">↗</span>
            </div>
            <span class="grid-tile-stack">{project.tags.join(' / ')}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
