---
import {
  siPython,
  siRust,
  siC,
  siHtml5,
  siCss,
  siJavascript,
  siGit,
  siPytorch,
  siFastapi,
  siReact,
  siTailwindcss,
  siSqlite,
  siQdrant,
  siMqtt,
  siRos,
} from 'simple-icons';
import { faGithub, faLinkedin } from '@fortawesome/free-brands-svg-icons';
interface Props {
  name: string;
  size?: number;
}
const { name, size = 20 } = Astro.props;
// Brand marks come from maintained icon libraries, never generic look-alikes.
const technologies = {
  Python: siPython,
  Rust: siRust,
  C: siC,
  HTML: siHtml5,
  CSS: siCss,
  JavaScript: siJavascript,
  Git: siGit,
  PyTorch: siPytorch,
  FastAPI: siFastapi,
  React: siReact,
  'React 19': siReact,
  'Tailwind CSS': siTailwindcss,
  SQLite: siSqlite,
  'Qdrant / RAG': siQdrant,
  MQTT: siMqtt,
  'ROS 2': siRos,
};
const technology = technologies[name as keyof typeof technologies];
const platform =
  name === 'GitHub' ? faGithub : name === 'LinkedIn' ? faLinkedin : undefined;
const paths = platform
  ? [platform.icon[4]].flat()
  : technology
    ? [technology.path]
    : [];
const viewBox = platform
  ? `0 0 ${platform.icon[0]} ${platform.icon[1]}`
  : '0 0 24 24';
---

{paths.length > 0 && (
  <svg
    class="brand-icon"
    data-brand={name}
    width={size}
    height={size}
    viewBox={viewBox}
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    {paths.map((path) => (
      <path d={path} />
    ))}
  </svg>
)}
