---
import { getBrandIcon } from '../lib/brand-icons';
interface Props {
  name: string;
  size?: number;
}
const { name, size = 20 } = Astro.props;
// Brand marks come from maintained icon libraries, never generic look-alikes.
const icon = getBrandIcon(name);
---

{icon && (
  <svg
    class="brand-icon"
    data-brand={name}
    width={size}
    height={size}
    viewBox={icon.viewBox}
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    {icon.paths.map((path) => (
      <path d={path} />
    ))}
  </svg>
)}
