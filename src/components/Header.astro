---
import type { Locale } from '../data/resume';
import { content, profile } from '../data/resume';
import Icon from './Icon.astro';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale];
const sections = Object.entries(t.nav);
---

<header class="site-header">
  <a
    class="wordmark"
    href={locale === 'zh' ? '/' : '/en/'}
    aria-label={`${profile.name} — Home`}
  >
    <span class="brand-mark">
      jz<span aria-hidden="true">✳</span>
    </span>
    <span class="wordmark-name">
      {profile.name
        .toUpperCase()
        .split(' ')
        .map((part, i) => (
          <>
            {i > 0 && <br />}
            {part}
          </>
        ))}
    </span>
  </a>
  <nav
    aria-label={locale === 'zh' ? '主导航' : 'Main navigation'}
    class="desktop-nav"
  >
    {sections.map(([id, label]) => (
      <a href={`#${id}`} data-astro-reload>
        {label}
      </a>
    ))}
  </nav>
  <div class="header-actions">
    <div
      class="language-switch"
      aria-label={locale === 'zh' ? '语言' : 'Language'}
    >
      <a
        href="/"
        lang="zh-CN"
        hreflang="zh-CN"
        aria-current={locale === 'zh' ? 'page' : undefined}
      >
        中
      </a>
      <span>/</span>
      <a
        href="/en/"
        lang="en"
        hreflang="en"
        aria-current={locale === 'en' ? 'page' : undefined}
      >
        EN
      </a>
    </div>
    <a class="header-download" href={profile.resume} download>
      {t.download}
      <Icon name="download" size={15} />
    </a>
  </div>
</header>
