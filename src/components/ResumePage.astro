---
import type { Locale } from '../data/resume';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './sections/Hero.astro';
import Projects from './sections/Projects.astro';
import Experience from './sections/Experience.astro';
import About from './sections/About.astro';
import Contact from './sections/Contact.astro';
import GitHubActivity from './interactive/GitHubActivity';
const { locale } = Astro.props as { locale: Locale };
---

<Layout locale={locale}>
  <Header locale={locale} />
  <main id="main">
    <div class="scroll-scene" id="top" data-scene-first>
      <div class="scene-stage">
        <div class="scene-content">
          <Hero locale={locale} />
        </div>
      </div>
    </div>
    <div class="scroll-scene" id="work">
      <div class="scene-stage">
        <div class="scene-content">
          <Projects locale={locale} />
        </div>
      </div>
    </div>
    <div class="scroll-scene" id="experience" data-palette="muted">
      <div class="scene-stage">
        <div class="scene-content">
          <Experience locale={locale} />
        </div>
      </div>
    </div>
    <div class="scroll-scene" id="about">
      <div class="scene-stage">
        <div class="scene-content">
          <About locale={locale} />
        </div>
      </div>
    </div>
    <!-- Animate the Astro wrapper without mutating React's hydration-owned DOM. -->
    <div class="scroll-scene" id="github">
      <div class="scene-stage">
        <div class="scene-content">
          <GitHubActivity
            locale={locale}
            client:visible={{ rootMargin: '150%' }}
          />
        </div>
      </div>
    </div>
  </main>
  <div class="scroll-scene" id="contact" data-palette="dark" data-scene-last>
    <div class="scene-stage">
      <div class="scene-content">
        <Contact locale={locale} />
      </div>
    </div>
  </div>
</Layout>
