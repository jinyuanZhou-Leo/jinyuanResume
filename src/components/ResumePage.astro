---
import type { Locale } from '../data/resume';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './sections/Hero.astro';
import Projects from './sections/Projects.astro';
import Experience from './sections/Experience.astro';
import About from './sections/About.astro';
import Contact from './sections/Contact.astro';
import GitHubActivity from './interactive/GitHubActivity';
const { locale } = Astro.props as { locale: Locale };
---

<Layout locale={locale}>
  <Header locale={locale} />
  <main id="main">
    <!-- The opening stays behind while the rest of the résumé slides over it. -->
    <div class="chapter chapter-hero" id="top">
      <Hero locale={locale} />
    </div>
    <div class="sheet">
      <div class="chapter" id="work">
        <Projects locale={locale} />
      </div>
      <div class="chapter" id="experience" data-tone="muted">
        <Experience locale={locale} />
      </div>
      <div class="chapter" id="about">
        <About locale={locale} />
      </div>
      <!-- Animate the Astro wrapper without mutating React's hydration-owned DOM. -->
      <div class="chapter" id="github">
        <GitHubActivity
          locale={locale}
          client:visible={{ rootMargin: '150%' }}
        />
      </div>
    </div>
  </main>
  <div class="chapter chapter-contact" id="contact">
    <Contact locale={locale} />
  </div>
</Layout>
