---
import { content, profile, type Locale } from '../../data/resume';
import Icon from '../Icon.astro';
import BrandIcon from '../BrandIcon.astro';
import SplitLines from '../text/SplitLines.astro';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale].contact;
const emails = [
  { address: profile.personalEmail, label: t.personal },
  { address: profile.email, label: t.university },
];
---

<footer class="contact-section">
  <div class="section">
    <div class="contact-top">
      <div>
        <p class="eyebrow" data-reveal="eyebrow">
          04 / {t.label}
        </p>
        <h2 data-reveal="lines">
          <SplitLines text={t.title} />
        </h2>
        <a
          class="button button-light"
          href={`mailto:${profile.personalEmail}`}
          data-reveal="fade"
          data-magnetic
        >
          {t.email}
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <img
        class="contact-art"
        src="/images/contact-crane.webp"
        alt=""
        width="1024"
        height="1024"
        loading="lazy"
      />
    </div>
    <section class="contact-bottom" aria-labelledby="contact-details-title">
      <h3 class="eyebrow" id="contact-details-title">
        {t.social}
      </h3>
      <div class="contact-directory">
        {emails.map(({ address, label }) => (
          <div class="contact-item email-item">
            <Icon name="mail" size={21} />
            <div class="contact-item-content">
              <span class="contact-label">{label}</span>
              <a href={`mailto:${address}`}>{address}</a>
            </div>
            <button
              class="copy-email"
              aria-label={`${t.copy}: ${address}`}
              data-email={address}
              data-success={t.copied}
              data-error={t.copyError}
            >
              <Icon name="copy" size={16} />
            </button>
            <p class="copy-status" role="status"></p>
          </div>
        ))}
        <a class="contact-item" href={`tel:${profile.phoneHref}`}>
          <Icon name="phone" size={21} />
          <span class="contact-item-content">
            <span class="contact-label">{t.phone}</span>
            <span>{profile.phone}</span>
          </span>
          <Icon size={16} />
        </a>
        <a
          class="contact-item"
          href={`https://github.com/${profile.github}`}
          target="_blank"
          rel="noreferrer"
        >
          <BrandIcon name="GitHub" size={23} />
          <span class="contact-item-content">
            <span class="contact-label">GitHub</span>
            <span>{profile.github}</span>
          </span>
          <Icon size={16} />
        </a>
        <a
          class="contact-item"
          href={profile.linkedin}
          target="_blank"
          rel="noreferrer"
        >
          <BrandIcon name="LinkedIn" size={22} />
          <span class="contact-item-content">
            <span class="contact-label">LinkedIn</span>
            <span>{profile.name}</span>
          </span>
          <Icon size={16} />
        </a>
      </div>
    </section>
    <div class="contact-marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <span class="marquee-copy">
            {t.footer}
            <i>✳</i>
            {profile.name}
            <i>✳</i>
          </span>
        ))}
      </div>
    </div>
    <div class="footer-line">
      <span>
        © {new Date().getFullYear()} {profile.name}{' '}
        <span class="footer-motto">/ {t.footer}</span>
      </span>
      <a href="#top" data-astro-reload>
        {t.back} ↑
      </a>
    </div>
  </div>
</footer>
