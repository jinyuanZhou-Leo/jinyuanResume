---
import ProjectGrid from '../ProjectGrid.astro';
import { content, type Locale } from '../../data/resume';
import SelectedWorkStack from '../interactive/SelectedWorkStack';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale].projects;
---

<section class="section work-section" aria-labelledby="work-title">
  <div class="work-overview-layer">
    <ProjectGrid locale={locale} />
  </div>
  <div class="work-intro-spacer" aria-hidden="true"></div>
  <div class="work-showcase">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / {t.label}</p>
        <h2 id="work-title">{t.title}</h2>
      </div>
      <p class="section-intro">{t.intro}</p>
    </div>
    <SelectedWorkStack locale={locale} client:load />
  </div>
</section>
