---
import ExperienceItem from '../ExperienceItem.astro';
import { content, experiences, type Locale } from '../../data/resume';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale].experience;
---

<section class="experience-section" aria-labelledby="experience-title">
  <div class="section experience-layout">
    <div class="experience-heading">
      <p class="eyebrow">02 / {t.label}</p>
      <h2 id="experience-title">{t.title}</h2>
    </div>
    <div class="experience-entries">
      {experiences.map((experience) => (
        <ExperienceItem experience={experience} locale={locale} />
      ))}
    </div>
  </div>
</section>
