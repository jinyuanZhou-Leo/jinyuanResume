---
import { content, profile, type Locale } from '../../data/resume';
import HeroGallery from '../HeroGallery.astro';
import Icon from '../Icon.astro';
import SplitChars from '../text/SplitChars.astro';
import SplitLines from '../text/SplitLines.astro';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale].hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="hero-intro">
      {t.intro}
      <span class="greeting-star" aria-hidden="true">
        ✳︎
      </span>
    </p>
    <h1 id="hero-title">
      <SplitChars text={profile.name.split(' ').join('\n')}>
        <span class="name-period">.</span>
      </SplitChars>
    </h1>
    <h2>
      <SplitLines text={t.line} />
    </h2>
    <p class="hero-description">{t.description}</p>
    <a class="button button-dark" href="#work" data-astro-reload data-magnetic>
      {t.cta}
      <Icon name="down" size={18} />
    </a>
  </div>
  <HeroGallery />
  <div class="hero-bottom">
    <span>
      <Icon name="pin" size={14} />
      {t.location}
    </span>
    <span class="hero-caption">{t.caption}</span>
    <a href="#work" data-astro-reload>
      {t.scroll}
      <span aria-hidden="true">↓</span>
    </a>
  </div>
  <span class="hero-shade" aria-hidden="true"></span>
</section>
