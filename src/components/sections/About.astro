---
import BrandIcon from '../BrandIcon.astro';
import EducationItem from '../EducationItem.astro';
import SplitLines from '../text/SplitLines.astro';
import { getBrandIcon } from '../../lib/brand-icons';
import { content, skills, education, type Locale } from '../../data/resume';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale].about;
// Each school's place on the timeline starts where the previous one ended.
const years = education.map(
  (school, i) => school.start ?? education[i - 1]?.end ?? school.end,
);
const finalYear = education[education.length - 1]?.end ?? '';
---

<section class="section about" aria-labelledby="about-title">
  <div class="about-heading">
    <p class="eyebrow" data-reveal="eyebrow">
      03 / {t.label}
    </p>
    <h2 id="about-title" data-reveal="lines">
      <SplitLines text={t.title} />
    </h2>
  </div>

  <!-- A timeline: a marker travels the rail and reaches each school in turn. -->
  <div class="about-education" data-final-year={finalYear}>
    <span class="education-rail" aria-hidden="true">
      <span></span>
    </span>
    <span class="education-marker" aria-hidden="true">
      <span class="education-year"></span>
    </span>
    <div class="education-list">
      {education.map((school, i) => (
        <EducationItem school={school} locale={locale} year={years[i]} />
      ))}
    </div>
  </div>

  <div class="about-toolkit">
    <div class="toolkit-title">
      <h3>{t.skills}</h3>
    </div>
    <ul class="toolkit-grid">
      {skills.map((skill) => (
        <li class="toolkit-item">
          <span class="toolkit-icon">
            {getBrandIcon(skill) ? (
              <BrandIcon name={skill} size={30} />
            ) : (
              <span class="toolkit-glyph" aria-hidden="true">
                {skill.slice(0, 1)}
              </span>
            )}
          </span>
          <span class="toolkit-label">{skill}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
