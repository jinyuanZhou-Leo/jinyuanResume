---
import BrandIcon from '../BrandIcon.astro';
import EducationItem from '../EducationItem.astro';
import { skillLayout } from '../../lib/chapter-timeline';
import {
  content,
  skills,
  education,
  abilities,
  type Locale,
} from '../../data/resume';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale].about;
const toolkit = skillLayout(skills.length);
---

<section class="section about-journey" aria-labelledby="about-title">
  <div class="journey-intro">
    <div class="journey-heading">
      <p class="eyebrow">03 / {t.label}</p>
      <h2 id="about-title">{t.title}</h2>
    </div>
    <div class="journey-bio-container">
      <p class="journey-bio">{t.text}</p>
    </div>
  </div>
  <div class="journey-stage">
    <div class="journey-line" aria-hidden="true"></div>
    <div
      class="journey-education"
      style={`--school-count:${Math.max(1, education.length)}`}
    >
      {education.map((school) => (
        <EducationItem school={school} locale={locale} />
      ))}
    </div>
    <div
      class="journey-toolkit"
      data-reading-stop
      style={`--toolkit-height:${toolkit.height}px`}
    >
      <div class="journey-icons">
        {skills.map((skill, i) => (
          <div
            class="journey-icon"
            style={`--icon-x:${toolkit.positions[i].x}%;--icon-y:${toolkit.positions[i].y}%`}
          >
            <BrandIcon name={skill} size={30} />
            <span>{skill}</span>
          </div>
        ))}
      </div>
      <div class="journey-toolkit-title">
        <h3>{t.skills}</h3>
        <p>
          {t.learning}
          <span class="learning-dots" aria-label="…">
            <i />
            <i />
            <i />
          </span>
        </p>
      </div>
    </div>
    <div class="journey-people">
      <h3>{t.people}</h3>
      <div class="journey-abilities">
        {abilities.map((ability, i) => (
          <p
            class="journey-ability"
            data-ability-id={ability.id}
            data-reading-stop
          >
            <span>{String(i + 1).padStart(2, '0')}</span>
            {ability.label[locale]}
          </p>
        ))}
      </div>
      <p class="journey-language">{t.languageText}</p>
    </div>
  </div>
</section>
